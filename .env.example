# ---- Language model -------------------------------------------------------
# auto = Anthropic if ANTHROPIC_API_KEY is set, else OpenAI-compatible if
# OPENAI_API_KEY / OPENAI_BASE_URL is set, else demo mode (no LLM, extractive).
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Any OpenAI-compatible API: OpenAI, Groq, Mistral, OpenRouter, Ollama, LM Studio...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Local & free with Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# ---- Embeddings (semantic search) -----------------------------------------
# none = BM25 keyword search only (no API needed)
# openai = OpenAI-compatible /embeddings (e.g. text-embedding-3-small, or nomic-embed-text on Ollama)
# sentence-transformers = local model, install sentence-transformers first
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=

# ---- Retrieval -------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MAX_UPLOAD_MB=25
DATA_DIR=data
